<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sec_tour_guide</name>
  <version>0.1.0</version>
  <description>SEC Robot Tour Guide — autonomous tour guide for Sarkeys Energy Center using TurtleBot 4</description>

  <maintainer email="joseph.p.lacsamana-1@ou.edu">Joseph Lacsamana</maintainer>

  <license>MIT</license>

  <author email="joseph.p.lacsamana-1@ou.edu">Joseph Lacsamana</author>
  <author email="avinash.r.kandadi-1@ou.edu">Avinash Kandadi</author>
  <author email="kalyani.valith-1@ou.edu">Kalyani Valith</author>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>action_msgs</depend>

  <!-- Phase 2: uncomment when GroupStatus.msg generation is wired up -->
  <!-- <buildtool_depend>rosidl_default_generators</buildtool_depend> -->
  <!-- <member_of_group>rosidl_interface_packages</member_of_group> -->

  <exec_depend>twist_mux</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
